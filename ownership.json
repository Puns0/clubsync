      "apps/api/src/modules/clubs/**",
      "apps/api/src/modules/meta/**",
      "apps/web/src/core/**",
      "apps/web/src/design-system/**",
      "apps/web/src/viz/**",
      "apps/web/src/pwa/**",
      "apps/web/src/modules/auth/**",
