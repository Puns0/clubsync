# ── Runtime ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://clubsync:clubsync_dev@127.0.0.1:5432/clubsync

# ── Security keys (generate with `npm run gen:secrets`) ─────────
FIELD_ENCRYPTION_KEY=          # 32 bytes, base64-encoded
OTP_SECRET=                    # 32+ random hex chars
QR_HMAC_SECRET=                # 32+ random hex chars
CSRF_SECRET=                   # 32+ random hex chars
USN_HASH_SECRET=               # 32+ random hex chars

# ── Email ────────────────────────────────────────────────────────
RESEND_API_KEY=                # optional in dev (uses ConsoleMailer)
MAIL_FROM=ClubSync <noreply@clubsync.local>

# ── Registration ─────────────────────────────────────────────────
ALLOWED_EMAIL_DOMAINS=sjbit.edu.in
ALLOW_ANY_EMAIL_DOMAIN=true    # dev only — allows demo.clubsync.local etc.

# ── Proxy ────────────────────────────────────────────────────────
TRUST_PROXY=false              # set to true behind Cloudflare Tunnel

# ── Static serving (optional: API serves the built web app) ─────
# WEB_DIST=../web/dist

# ── Dev tools ────────────────────────────────────────────────────
DEV_AUTH_BYPASS=false           # header X-Dev-User: <email> authenticates as that user
ADMIN_BOOTSTRAP_EMAIL=admin@clubsync.local
ADMIN_BOOTSTRAP_PASSWORD=Admin123456!
